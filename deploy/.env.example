# 复制为 deploy/.env 后修改密码：cp .env.example .env
# 生成密码：openssl rand -base64 24 | tr -d '/+=' | cut -c1-24
# 约束：Redis 密码只用字母数字（会拼进 redis://:pwd@host:port/0）；三库密码都不要含 $ " ' 空格。

# 监听地址：0.0.0.0 = 公网直连（安全组必须只放行你的出口 IP）；
# 127.0.0.1 = 完全不对公网，本机走 SSH 隧道（见 README「方式 B」）
BIND_ADDR=0.0.0.0

# 宿主端口（高位端口降低扫描噪声；想用标准端口就改成 3306/5432/6379）
MARIADB_HOST_PORT=13306
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379

# MariaDB 业务库
MARIADB_DATABASE=devpipeline
MARIADB_USER=devpipeline
MARIADB_PASSWORD=CHANGE_ME_mariadb_app_pwd
MARIADB_ROOT_PASSWORD=CHANGE_ME_mariadb_root_pwd

# PostgreSQL：只放 LangGraph checkpointer 表
POSTGRES_DB=devpipeline_graph
POSTGRES_USER=devpipeline
POSTGRES_PASSWORD=CHANGE_ME_postgres_pwd

# Redis：arq 队列 + 事件广播
REDIS_PASSWORD=CHANGE_ME_redis_pwd
